node_modules/
dist/
# Root data dir only (SQLite + uploads) — an unanchored "data/" also swallowed
# client/src/quote/data/, which broke the deploy build.
/data/
*.db
*.db-shm
*.db-wal
.env
.env.*
*.log
.DS_Store

# Per-machine editor state. `launch.json` IS shared (it defines how to run the
# app); these two are personal and were committed by accident — settings.local
# is one developer's permission allowlist, and the lock file is transient.
.claude/settings.local.json
.claude/scheduled_tasks.lock
